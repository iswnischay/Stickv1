// Paste these into Firebase console -> Firestore Database -> Rules, then Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each player can read and write only their own profile (username + saved moves)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // username -> owner; anyone signed in can check if a name is free, only the owner can take or release it
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,16}$');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
