{
  "name": "stick-v1-desktop",
  "productName": "Stick v1",
  "version": "1.1.0",
  "description": "Stick v1 desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node copy-web.js && electron .",
    "dist:win": "node copy-web.js && electron-builder --win",
    "dist:mac": "node copy-web.js && electron-builder --mac",
    "dist:linux": "node copy-web.js && electron-builder --linux"
  },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.stickv1.game",
    "productName": "Stick v1",
    "files": ["main.js", "web/**"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.games" },
    "linux": { "target": ["AppImage"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
